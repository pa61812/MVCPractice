@{
    ViewBag.Title = "Home Page";
}
<br />
<div>
    <p>帳號: <input type="text" id="key" /></p>
</div>
<div>
    <input type="button" value="查詢" id="Search" />
</div>

<table width="50%" border="1" cellpadding="0" cellspacing="0">
    <tr>
        @*顯示的欄位名*@
        <td>帳號</td>
        <td>密碼</td>
        <td>人名</td>
        <td>手機</td>
        <td>電話</td>
        <td>性別</td>
        <td>生日</td>
    </tr>
    @*資料庫的內容*@
    <tbody id="bg">
    </tbody>
</table>


@section scripts{
    <script type="text/javascript">

        $(document).ready(function () {
            Load()
            $("#Search").click(function () {
                //if ($("#key").val() =="" || $("#key").val()==null) {
                //    alert("請輸入帳號");
                //}
                //else {
                //    Load();
                //}
                Load();

            })         

        //查詢條件傳入
        function Load()
        {
　　       var key = $("#key").val(); 
　　      $.ajax({
            url:"/Home/UserSerach", 
            data:{key:key}, //查詢值
            type:"POST",
            dataType:"JSON",
            success: function(data){
                var str = "";


                for (var i = 0; i < data.length; i++) {
                    str += "<tr><td>" + data[i]["Account"] + "</td><td>" + data[i]["Password"] +
                        "</td><td>" + data[i]["Name"] + "</td><td>" + data[i]["Phone"] +
                        "</td><td>" + data[i]["Tel"] + "</td><td>" + data[i]["Gender"] +
                        "</td><td>" + data[i]["Birthday"] + "</td></tr>";
                }
            　　　　　
            
                
             $("#bg").html(str);


                }       
            });
        } 


        });
    </script>
}